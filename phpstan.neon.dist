includes:
  - 'tools/phpstan/vendor/phpstan/phpstan-phpunit/extension.neon'
  - 'tools/phpstan/vendor/phpstan/phpstan-phpunit/rules.neon'
  - 'tools/phpstan/vendor/szepeviktor/phpstan-wordpress/extension.neon'
  - 'tools/phpstan/vendor/ekino/phpstan-banned-code/extension.neon'

parameters:
  level: max
  paths:
    - public/app/

  scanFiles:
    - 'vendor-bin/phpstan/vendor/php-stubs/wordpress-stubs/wordpress-stubs.php'
    - 'vendor-bin/phpstan/vendor/php-stubs/wordpress-globals/wordpress-globals.php'
    - 'vendor-bin/phpstan/vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php'
    - 'vendor-bin/phpstan/vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php'
    - 'vendor-bin/phpstan/vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php'

tmpDir: '.var/cache/phpstan'
