{
    "name": "jascha030/wp-starter",
    "description": "Wordpress development environment.",
    "type": "project",
    "authors": [
        {
            "name": "Jascha030",
            "email": "contact@jaschavanaalst.nl"
        }
    ],
    "require": {
        "php": ">=8.2",
        "bamarni/composer-bin-plugin": "^1.8",
        "composer/installers": "^2.3",
        "jascha030/xerox": "^0.4.0",
        "roots/wordpress": "^6.7",
        "roots/wp-password-bcrypt": "^1.2",
        "vlucas/phpdotenv": "^5.6",
        "wpackagist-theme/twentytwentythree": "^1.6"
    },
    "require-dev": {
        "composer/composer": "^2.3",
        "ergebnis/composer-normalize": "^2.44",
        "roave/security-advisories": "dev-latest"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "composer/installers": true,
            "ergebnis/composer-normalize": true,
            "roots/wordpress-core-installer": true
        },
        "platform": {
            "php": "8.2"
        },
        "platform-check": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "vendor-dir": "public/vendor"
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true,
            "target-directory": "tools"
        },
        "composer-normalize": {
            "indent-size": 4,
            "indent-style": "space"
        },
        "installer-paths": {
            "public/app/mu-plugins/{$name}/": [
                "roots/wp-password-bcrypt",
                "type:wordpress-muplugin"
            ],
            "public/app/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "public/app/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "public/wordpress"
    },
    "scripts": {
        "init:wp": "@initwp",
        "initwp": "xerographer init"
    }
}
